---
---

<!-- Premium Tariffs Section - Inner Refraction Effect -->
<section class="tariffs-section">
  <div class="tariffs-container">
    <!-- Section Header -->
    <div class="section-header">
      <h2 class="section-title">Tarifas de Asesoría</h2>
      <p class="section-subtitle">Transparencia desde el primer momento</p>
    </div>

    <!-- Pricing Cards -->
    <div class="pricing-grid">
      <!-- Virtual Card -->
      <div class="pricing-card">
        <!-- Outer Shell -->
        <div class="card-outer">
          <!-- Inner Core with refraction -->
          <div class="card-inner">
            <div class="card-refraction"></div>
            <div class="card-content">
              <div class="icon-wrapper">
                <svg width="40" height="40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                </svg>
              </div>
              <h3 class="card-title">Asesoría Virtual</h3>
              <div class="price-wrapper">
                <span class="price">$100.000</span>
                <span class="price-currency">COP</span>
              </div>
              <p class="card-description">
                Sesión remota de hasta 1 hora para revisión inicial de documentos y estrategia base.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Presencial Card (Highlighted with Gold) -->
      <div class="pricing-card recommended">
        <!-- Outer Shell - Gold tinted -->
        <div class="card-outer gold">
          <!-- Inner Core -->
          <div class="card-inner">
            <div class="card-refraction gold"></div>
            <div class="card-content">
              <!-- Badge -->
              <div class="badge">Recomendado</div>
              
              <div class="icon-wrapper gold">
                <svg width="40" height="40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                </svg>
              </div>
              <h3 class="card-title light">Asesoría Presencial</h3>
              <div class="price-wrapper">
                <span class="price light">$150.000</span>
                <span class="price-currency light">COP</span>
              </div>
              <p class="card-description light">
                Atención personalizada en nuestra sede en El Poblado. Análisis profundo de su caso.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Note -->
    <div class="note">
      <p>El primer contacto telefónico para validación de viabilidad es totalmente gratuito.</p>
    </div>
  </div>
</section>

<style>
  /* === SECTION === */
  .tariffs-section {
    padding: 7rem 1.5rem;
    background: #fff8f9;
  }

  .tariffs-container {
    max-width: 900px;
    margin: 0 auto;
  }

  /* === SECTION HEADER === */
  .section-header {
    text-align: center;
    margin-bottom: 4rem;
    opacity: 0;
    animation: fadeUp 0.7s cubic-bezier(0.32, 0.72, 0, 1) both;
  }

  .section-title {
    font-family: 'Noto Serif', serif;
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    color: #401C34;
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem;
  }

  .section-subtitle {
    font-family: 'Manrope', sans-serif;
    font-size: 1rem;
    color: rgba(64, 28, 52, 0.7);
  }

  /* === PRICING GRID === */
  .pricing-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    justify-items: center;
  }

  /* === DOUBLE-BEZEL CARD === */
  .pricing-card {
    width: 100%;
    max-width: 380px;
    opacity: 0;
    animation: fadeUp 0.7s cubic-bezier(0.32, 0.72, 0, 1) calc(0.1s) both;
  }

  .pricing-card.recommended {
    animation-delay: 0.2s;
  }

  /* Outer Shell */
  .card-outer {
    padding: 4px;
    background: rgba(64, 28, 52, 0.04);
    border: 1px solid rgba(64, 28, 52, 0.08);
    border-radius: 1.75rem;
    transition: all 0.5s cubic-bezier(0.32, 0.72, 0, 1);
  }

  .card-outer.gold {
    background: rgba(154, 140, 91, 0.1);
    border-color: rgba(154, 140, 91, 0.2);
  }

  .pricing-card:hover .card-outer {
    transform: translateY(-6px);
    box-shadow: 0 24px 56px -8px rgba(64, 28, 52, 0.14);
  }

  .pricing-card.recommended:hover .card-outer.gold {
    box-shadow: 0 24px 56px -8px rgba(154, 140, 91, 0.3);
  }

  /* Inner Core */
  .card-inner {
    position: relative;
    padding: 2.5rem;
    background: white;
    border-radius: calc(1.75rem - 4px);
    border: 1px solid rgba(64, 28, 52, 0.04);
    overflow: hidden;
    text-align: center;
  }

  .card-outer.gold .card-inner {
    background: linear-gradient(145deg, #28071f 0%, #401c34 100%);
    border-color: transparent;
  }

  /* Inner Refraction Effect */
  .card-refraction {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 50%;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.08) 0%, transparent 100%);
    pointer-events: none;
  }

  .card-refraction.gold {
    background: linear-gradient(180deg, rgba(154, 140, 91, 0.15) 0%, transparent 50%);
  }

  /* Card Content */
  .card-content {
    position: relative;
    z-index: 1;
  }

  /* === BADGE === */
  .badge {
    position: absolute;
    top: 1.25rem;
    left: -1.5rem;
    padding: 0.375rem 0.875rem;
    background: #9A8C5B;
    color: white;
    font-family: 'Manrope', sans-serif;
    font-size: 0.6rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    border-radius: 9999px;
  }

  /* === ICON === */
  .icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 4.5rem;
    height: 4.5rem;
    margin: 0 auto 1.5rem;
    background: rgba(154, 140, 91, 0.1);
    border-radius: 50%;
    transition: all 0.4s cubic-bezier(0.32, 0.72, 0, 1);
  }

  .icon-wrapper.gold {
    background: rgba(154, 140, 91, 0.2);
  }

  .icon-wrapper svg {
    color: #9A8C5B;
  }

  /* === TYPOGRAPHY === */
  .card-title {
    font-family: 'Noto Serif', serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: #401C34;
    margin-bottom: 1rem;
    letter-spacing: -0.01em;
  }

  .card-title.light {
    color: white;
  }

  .price-wrapper {
    margin-bottom: 1rem;
  }

  .price {
    font-family: 'Manrope', sans-serif;
    font-size: 2.75rem;
    font-weight: 800;
    color: #401C34;
    letter-spacing: -0.02em;
  }

  .price.light {
    color: white;
  }

  .price-currency {
    font-size: 1rem;
    font-weight: 400;
    color: rgba(64, 28, 52, 0.6);
    margin-left: 0.25rem;
  }

  .price-currency.light {
    color: rgba(255, 255, 255, 0.6);
  }

  .card-description {
    font-family: 'Manrope', sans-serif;
    font-size: 0.9rem;
    line-height: 1.65;
    color: rgba(64, 28, 52, 0.7);
  }

  .card-description.light {
    color: rgba(255, 255, 255, 0.75);
  }

  /* === NOTE === */
  .note {
    margin-top: 3rem;
    text-align: center;
    opacity: 0;
    animation: fadeUp 0.7s cubic-bezier(0.32, 0.72, 0, 1) 0.3s both;
  }

  .note p {
    font-family: 'Manrope', sans-serif;
    font-size: 0.8rem;
    font-style: italic;
    color: rgba(64, 28, 52, 0.6);
  }

  /* === ANIMATION === */
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(32px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* === RESPONSIVE === */
  @media (max-width: 768px) {
    .tariffs-section {
      padding: 5rem 1.25rem;
    }

    .pricing-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .pricing-card {
      max-width: 100%;
    }

    .pricing-card.recommended {
      order: -1;
    }

    .section-header {
      margin-bottom: 2.5rem;
    }
  }
</style>
