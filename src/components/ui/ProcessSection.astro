---
const processSteps = [
  {
    number: "01",
    title: "Contacto Inicial",
    description: "Complete el formulario o llámenos. Respondemos en menos de 24 horas para validar la viabilidad de su caso."
  },
  {
    number: "02",
    title: "Asesoría Virtual",
    description: "Sesión por videollamada para revisar documentos, analizar su situación y definir la estrategia jurídica a seguir."
  },
  {
    number: "03",
    title: "Seguimiento Personalizado",
    description: "Atención directa del abogado titular. Las reuniones presenciales se acuerdan según conveniencia mutua."
  }
];
---

<!-- Premium Process Section - Timeline with Double-Bezel Step Cards -->
<section class="process-section">
  <div class="process-container">
    <!-- Section Header -->
    <div class="section-header">
      <h2 class="section-title">Cómo Trabajamos</h2>
      <p class="section-subtitle">
        Un proceso claro y eficiente para resolver su situación legal
      </p>
    </div>

    <!-- Timeline with Steps -->
    <div class="timeline">
      <!-- Vertical Line -->
      <div class="timeline-line"></div>

      {processSteps.map((step, index) => (
        <div 
          class="step-card"
          style={`--stagger-delay: ${0.1 + index * 0.15}s`}
        >
          <!-- Double-Bezel Container -->
          <div class="card-bezel">
            <!-- Inner Core -->
            <div class="card-core">
              <!-- Step Number -->
              <div class="step-number-wrapper">
                <span class="step-number">{step.number}</span>
              </div>

              <!-- Content -->
              <div class="step-content">
                <h3 class="step-title">{step.title}</h3>
                <p class="step-description">{step.description}</p>
              </div>

              <!-- Connector -->
              <div class="step-connector">
                <div class="connector-dot"></div>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Note about in-person meetings -->
    <div class="process-note">
      <div class="note-icon">
        <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <p>
        <strong>Asesoría presencial:</strong> Coordinamos directamente según su disponibilidad y la del abogado.
      </p>
    </div>
  </div>
</section>

<style>
  /* === SECTION === */
  .process-section {
    padding: 7rem 1.5rem;
    background: #fff8f9;
  }

  .process-container {
    max-width: 700px;
    margin: 0 auto;
  }

  /* === SECTION HEADER === */
  .section-header {
    text-align: center;
    margin-bottom: 4.5rem;
    opacity: 0;
    animation: fadeUp 0.7s cubic-bezier(0.32, 0.72, 0, 1) both;
  }

  .section-title {
    font-family: 'Noto Serif', serif;
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    color: #401C34;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin-bottom: 1rem;
  }

  .section-subtitle {
    font-family: 'Manrope', sans-serif;
    font-size: 1rem;
    color: rgba(64, 28, 52, 0.7);
    max-width: 500px;
    margin: 0 auto;
  }

  /* === TIMELINE === */
  .timeline {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* Vertical Line */
  .timeline-line {
    position: absolute;
    left: 1.75rem;
    top: 2.5rem;
    bottom: 2.5rem;
    width: 1px;
    background: linear-gradient(to bottom, #9A8C5B, rgba(154, 140, 91, 0.2));
  }

  /* === STEP CARD === */
  .step-card {
    position: relative;
    opacity: 0;
    animation: fadeUp 0.7s cubic-bezier(0.32, 0.72, 0, 1) calc(var(--stagger-delay)) both;
  }

  /* Double-Bezel */
  .card-bezel {
    padding: 3px;
    background: rgba(64, 28, 52, 0.03);
    border: 1px solid rgba(64, 28, 52, 0.06);
    border-radius: 1.5rem;
    transition: all 0.5s cubic-bezier(0.32, 0.72, 0, 1);
  }

  .step-card:hover .card-bezel {
    transform: translateX(8px);
    box-shadow: 0 16px 40px -8px rgba(64, 28, 52, 0.12);
    border-color: rgba(64, 28, 52, 0.1);
  }

  /* Inner Core */
  .card-core {
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
    padding: 2rem;
    background: white;
    border-radius: calc(1.5rem - 3px);
    border: 1px solid rgba(64, 28, 52, 0.04);
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.8);
  }

  /* === STEP NUMBER === */
  .step-number-wrapper {
    flex-shrink: 0;
    width: 3.5rem;
    height: 3.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(154, 140, 91, 0.08);
    border: 1px solid rgba(154, 140, 91, 0.15);
    border-radius: 50%;
    transition: all 0.4s cubic-bezier(0.32, 0.72, 0, 1);
  }

  .step-card:hover .step-number-wrapper {
    transform: scale(1.08);
    background: rgba(154, 140, 91, 0.12);
  }

  .step-number {
    font-family: 'Noto Serif', serif;
    font-size: 1.375rem;
    font-weight: 800;
    color: #9A8C5B;
    line-height: 1;
  }

  /* === CONTENT === */
  .step-content {
    flex: 1;
    padding-top: 0.5rem;
  }

  .step-title {
    font-family: 'Noto Serif', serif;
    font-size: 1.25rem;
    font-weight: 700;
    color: #401C34;
    margin-bottom: 0.5rem;
    letter-spacing: -0.01em;
  }

  .step-description {
    font-family: 'Manrope', sans-serif;
    font-size: 0.9rem;
    color: rgba(64, 28, 52, 0.7);
    line-height: 1.6;
  }

  /* === CONNECTOR === */
  .step-connector {
    position: absolute;
    left: 1.75rem;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .connector-dot {
    width: 0.5rem;
    height: 0.5rem;
    background: #9A8C5B;
    border-radius: 50%;
    box-shadow: 0 0 0 3px rgba(154, 140, 91, 0.15);
    animation: connectorPulse 2s ease-in-out infinite;
  }

  @keyframes connectorPulse {
    0%, 100% { box-shadow: 0 0 0 3px rgba(154, 140, 91, 0.15); }
    50% { box-shadow: 0 0 0 6px rgba(154, 140, 91, 0.08); }
  }

  /* === NOTE === */
  .process-note {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.875rem;
    margin-top: 3rem;
    padding: 1.25rem 1.5rem;
    background: rgba(154, 140, 91, 0.06);
    border: 1px solid rgba(154, 140, 91, 0.12);
    border-radius: 1rem;
    opacity: 0;
    animation: fadeUp 0.7s cubic-bezier(0.32, 0.72, 0, 1) 0.45s both;
  }

  .note-icon {
    flex-shrink: 0;
    color: #9A8C5B;
  }

  .process-note p {
    font-family: 'Manrope', sans-serif;
    font-size: 0.875rem;
    color: rgba(64, 28, 52, 0.8);
    line-height: 1.5;
  }

  .process-note strong {
    color: #9A8C5B;
    font-weight: 600;
  }

  /* === ANIMATION === */
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(32px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* === RESPONSIVE === */
  @media (max-width: 768px) {
    .process-section {
      padding: 5rem 1.25rem;
    }

    .timeline-line {
      display: none;
    }

    .step-connector {
      display: none;
    }

    .card-core {
      padding: 1.5rem;
    }

    .step-number-wrapper {
      width: 3rem;
      height: 3rem;
    }

    .step-number {
      font-size: 1.125rem;
    }

    .step-title {
      font-size: 1.125rem;
    }

    .section-header {
      margin-bottom: 3rem;
    }
  }
</style>
