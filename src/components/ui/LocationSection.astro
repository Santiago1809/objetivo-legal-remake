---
---

<section style="padding: 6rem 1.5rem; background: var(--color-surface, #fff8f9);">
  <div style="max-width: 1200px; margin: 0 auto;">
    <!-- Section Header -->
    <div style="margin-bottom: 3rem; animation: fadeUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;">
      <h2 style="font-family: 'Noto Serif', serif; font-size: clamp(1.75rem, 4vw, 2.5rem); font-weight: 800; color: var(--color-primary-container, #401C34); letter-spacing: -0.02em; line-height: 1.1;">
        Nuestra Sede en Medellin
      </h2>
    </div>

    <!-- Split Screen - Map (60%) + Info (40%) -->
    <div style="display: flex; flex-wrap: wrap; gap: 2rem; align-items: stretch; min-height: 400px;">
      <!-- Map -->
      <div style="flex: 1 1 500px; border-radius: 1.5rem; overflow: hidden; box-shadow: 0 20px 40px -12px rgba(64, 28, 52, 0.15); animation: fadeUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.1s both;">
        <iframe 
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3966.521260322283!2d-75.5617394!3d6.2087437!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8e4428293e4b5e45%3A0xd6cf3837837d87e9!2sEl%20Poblado%2C%20Medell%C3%ADn%2C%20Antioquia!5e0!3m2!1sen!2sco!4v1635000000000!5m2!1sen!2sco"
          width="100%" 
          height="100%" 
          style="border:0; min-height: 400px;" 
          allowfullscreen="" 
          loading="lazy"
        ></iframe>
      </div>

      <!-- Info Cards - stacked vertical -->
      <div style="flex: 1 1 300px; display: flex; flex-direction: column; gap: 1.5rem; animation: fadeUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.2s both;">
        <!-- Address Card -->
        <div style="padding: 2rem; border-radius: 1rem; background: white; border: 1px solid rgba(64, 28, 52, 0.08); flex: 1;">
          <div style="display: flex; align-items: flex-start; gap: 1rem;">
            <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; display: flex; align-items: center; justify-content: center; background: var(--color-surface, #fff8f9); flex-shrink: 0;">
              <svg style="width: 1.5rem; height: 1.5rem; color: var(--color-primary-container, #401C34);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div>
              <h3 style="font-family: 'Noto Serif', serif; font-size: 1.125rem; font-weight: 700; color: var(--color-primary-container, #401C34); margin-bottom: 0.5rem;">
                Direccion
              </h3>
              <p style="font-family: 'Manrope', sans-serif; font-size: 0.9rem; color: rgba(64, 28, 52, 0.7); line-height: 1.6;">
                Edificio Square, El Poblado<br />
                Medellin, Colombia
              </p>
            </div>
          </div>
        </div>

        <!-- Hours Card -->
        <div style="padding: 2rem; border-radius: 1rem; background: white; border: 1px solid rgba(64, 28, 52, 0.08); flex: 1;">
          <div style="display: flex; align-items: flex-start; gap: 1rem;">
            <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; display: flex; align-items: center; justify-content: center; background: var(--color-surface, #fff8f9); flex-shrink: 0;">
              <svg style="width: 1.5rem; height: 1.5rem; color: var(--color-primary-container, #401C34);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div>
              <h3 style="font-family: 'Noto Serif', serif; font-size: 1.125rem; font-weight: 700; color: var(--color-primary-container, #401C34); margin-bottom: 0.5rem;">
                Horario
              </h3>
              <p style="font-family: 'Manrope', sans-serif; font-size: 0.9rem; color: rgba(64, 28, 52, 0.7); line-height: 1.6;">
                Lunes a Viernes: 8:00 AM - 6:00 PM<br />
                Sabados: 9:00 AM - 1:00 PM
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>