---
const currentYear = new Date().getFullYear();
---

<!-- Premium Footer - Refined Typography Hierarchy -->
<footer class="footer">
  <div class="footer-container">
    <div class="footer-main">
      <!-- Brand with Logo -->
      <div class="footer-brand">
        <a href="/" class="brand-link">
          <img src="/logo.png" alt="Objetivo Legal" class="brand-logo" />
          <span class="brand-name">
            <span class="brand-objetivo">Objetivo</span>
            <span class="brand-legal">Legal</span>
          </span>
        </a>
      </div>

      <!-- Navigation Links -->
      <div class="footer-nav">
        <a href="/derecho-de-danos" class="footer-link">Derecho de Daños</a>
        <a href="/insolvencia" class="footer-link">Insolvencia</a>
        <a href="#" class="footer-link">Aviso de Privacidad</a>
        <a href="#" class="footer-link">Términos de Servicio</a>
      </div>
    </div>

    <!-- Copyright -->
    <div class="footer-copyright">
      <p>&copy; {currentYear} Objetivo Legal. Medellín, Colombia. Todos los derechos reservados.</p>
    </div>
  </div>
</footer>

<style>
  /* === FOOTER === */
  .footer {
    background: #fbf1f4;
    padding: 3rem 1.5rem;
    border-top: 1px solid rgba(64, 28, 52, 0.06);
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  /* === MAIN CONTENT === */
  .footer-main {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  /* === BRAND === */
  .footer-brand {
    display: flex;
    align-items: center;
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    transition: opacity 0.3s cubic-bezier(0.32, 0.72, 0, 1);
  }

  .brand-link:hover {
    opacity: 0.8;
  }

  .brand-logo {
    height: 2rem;
    width: auto;
  }

  .brand-name {
    font-family: 'Noto Serif', serif;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .brand-objetivo {
    color: #401C34;
  }

  .brand-legal {
    color: #9A8C5B;
  }

  /* === NAVIGATION === */
  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2rem;
  }

  .footer-link {
    font-family: 'Manrope', sans-serif;
    font-size: 0.875rem;
    color: rgba(64, 28, 52, 0.7);
    text-decoration: none;
    transition: color 0.3s cubic-bezier(0.32, 0.72, 0, 1);
  }

  .footer-link:hover {
    color: #9A8C5B;
  }

  /* === COPYRIGHT === */
  .footer-copyright {
    width: 100%;
    text-align: center;
    padding-top: 2rem;
    border-top: 1px solid rgba(64, 28, 52, 0.06);
  }

  .footer-copyright p {
    font-family: 'Manrope', sans-serif;
    font-size: 0.75rem;
    color: rgba(64, 28, 52, 0.5);
    letter-spacing: 0.02em;
  }

  /* === RESPONSIVE === */
  @media (max-width: 768px) {
    .footer {
      padding: 2.5rem 1.25rem;
    }

    .footer-main {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 1.5rem;
    }

    .footer-nav {
      flex-direction: column;
      gap: 1rem;
    }

    .footer-copyright {
      padding-top: 1.5rem;
    }
  }
</style>
