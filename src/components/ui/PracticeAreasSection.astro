---
const practiceAreas = [
  {
    icon: "car_crash",
    title: "Derecho de Daños",
    description: "Representación legal en casos de accidentes de tránsito, responsabilidad civil y demás daños patrimoniales y personales.",
    items: [
      "Accidentes de tránsito",
      "Responsabilidad civil contractual",
      "Daños materiales y morales",
      "Indemnización por perjuicios"
    ],
    href: "/derecho-de-danos"
  },
  {
    icon: "account_balance",
    title: "Insolvencia",
    description: "Asesoría integral para personas naturales y empresas en situación de sobreendeudamiento.",
    items: [
      "Reestructuración patrimonial",
      "Concordato preventivo",
      "Liquidación judicial",
      "Negociación con acreedores"
    ],
    href: "/insolvencia"
  }
];
---

<!-- Premium Practice Areas - Bento Grid with Double-Bezel Cards -->
<section class="practice-section">
  <div class="practice-container">
    <!-- Section Header - Left aligned -->
    <div class="section-header">
      <h2 class="section-title">Áreas de Práctica</h2>
    </div>

    <!-- Asymmetric Bento Grid -->
    <div class="bento-grid">
      {practiceAreas.map((area, index) => (
        <div 
          class="area-card"
          style={`--stagger-delay: ${0.1 + index * 0.15}s`}
        >
          <!-- Outer Shell - Double-Bezel -->
          <div class="card-outer">
            <!-- Inner Core -->
            <div class="card-inner">
              <!-- Icon Container -->
              <div class="icon-container">
                {area.icon === "car_crash" && (
                  <svg class="icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8 7h8m-8 5h4m4 0h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                )}
                {area.icon === "account_balance" && (
                  <svg class="icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                  </svg>
                )}
              </div>

              <!-- Title -->
              <h3 class="card-title">{area.title}</h3>

              <!-- Description -->
              <p class="card-description">{area.description}</p>

              <!-- Items List -->
              <ul class="items-list">
                {area.items.map((item, i) => (
                  <li class="item">
                    <svg class="item-check" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                    </svg>
                    {item}
                  </li>
                ))}
              </ul>

              <!-- Button -->
              <a href={area.href} class="card-button">
                <span>Saber más</span>
                <svg class="button-arrow" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* === SECTION === */
  .practice-section {
    padding: 7rem 1.5rem;
    background: #fff8f9;
  }

  .practice-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  /* === SECTION HEADER === */
  .section-header {
    margin-bottom: 4rem;
    opacity: 0;
    animation: fadeUp 0.7s cubic-bezier(0.32, 0.72, 0, 1) both;
  }

  .section-title {
    font-family: 'Noto Serif', serif;
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    color: #401C34;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  /* === BENTO GRID === */
  .bento-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  /* === DOUBLE-BEZEL CARD === */
  .area-card {
    opacity: 0;
    animation: fadeUp 0.7s cubic-bezier(0.32, 0.72, 0, 1) calc(var(--stagger-delay)) both;
  }

  /* Outer Shell */
  .card-outer {
    padding: 4px;
    background: rgba(64, 28, 52, 0.03);
    border: 1px solid rgba(64, 28, 52, 0.06);
    border-radius: 2rem;
    transition: all 0.5s cubic-bezier(0.32, 0.72, 0, 1);
  }

  .area-card:hover .card-outer {
    transform: translateY(-6px);
    box-shadow: 0 24px 56px -8px rgba(64, 28, 52, 0.12);
    border-color: rgba(64, 28, 52, 0.1);
  }

  /* Inner Core */
  .card-inner {
    padding: 2.5rem;
    background: white;
    border-radius: calc(2rem - 4px);
    border: 1px solid rgba(64, 28, 52, 0.04);
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.9);
  }

  /* === ICON === */
  .icon-container {
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.5rem;
    background: #fff8f9;
    border: 1px solid rgba(64, 28, 52, 0.06);
    transition: all 0.4s cubic-bezier(0.32, 0.72, 0, 1);
  }

  .area-card:hover .icon-container {
    transform: scale(1.05);
    background: #f5ebee;
  }

  .icon {
    width: 2rem;
    height: 2rem;
    color: #401C34;
  }

  /* === TYPOGRAPHY === */
  .card-title {
    font-family: 'Noto Serif', serif;
    font-size: 1.625rem;
    font-weight: 700;
    color: #401C34;
    margin-bottom: 0.875rem;
    letter-spacing: -0.01em;
  }

  .card-description {
    font-family: 'Manrope', sans-serif;
    font-size: 0.95rem;
    color: rgba(64, 28, 52, 0.7);
    line-height: 1.65;
    margin-bottom: 1.5rem;
  }

  /* === ITEMS LIST === */
  .items-list {
    list-style: none;
    margin: 0 0 1.75rem 0;
    padding: 0;
  }

  .item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: 'Manrope', sans-serif;
    font-size: 0.875rem;
    color: #401C34;
    padding: 0.5rem 0;
    border-bottom: 1px solid rgba(64, 28, 52, 0.05);
  }

  .item:last-child {
    border-bottom: none;
  }

  .item-check {
    width: 1.25rem;
    height: 1.25rem;
    color: #9A8C5B;
    flex-shrink: 0;
  }

  /* === BUTTON === */
  .card-button {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.875rem 1.5rem;
    background: #401C34;
    color: white;
    font-family: 'Manrope', sans-serif;
    font-size: 0.875rem;
    font-weight: 600;
    border-radius: 9999px;
    text-decoration: none;
    transition: all 0.4s cubic-bezier(0.32, 0.72, 0, 1);
  }

  .card-button:hover {
    background: #2a1524;
    gap: 0.875rem;
  }

  .card-button:active {
    transform: scale(0.97);
  }

  .button-arrow {
    width: 1rem;
    height: 1rem;
    transition: transform 0.3s cubic-bezier(0.32, 0.72, 0, 1);
  }

  .card-button:hover .button-arrow {
    transform: translateX(3px);
  }

  /* === ANIMATION === */
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(32px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* === RESPONSIVE === */
  @media (max-width: 768px) {
    .practice-section {
      padding: 5rem 1.25rem;
    }

    .bento-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .card-inner {
      padding: 2rem;
    }

    .section-header {
      margin-bottom: 2.5rem;
    }
  }
</style>
